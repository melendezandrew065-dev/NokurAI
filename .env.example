# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADSENSE_PUB_ID: Google AdSense Publisher ID (e.g., pub-6591682562691116).
# Used to configure ads.txt and Google AdSense site verification.
ADSENSE_PUB_ID="pub-6591682562691116"
# VITE_ADSENSE_SLOT_ID: Optional numeric AdSense display ad unit slot ID (leave empty to use AdSense Auto Ads).
VITE_ADSENSE_SLOT_ID=""

# STRIPE_SECRET_KEY: Required to actually charge customer credit cards and deduct real money from bank accounts.
# When provided, transactions run through live bank acquiring rails with auto-payout to your bank/Google Pay.
# Get your secret key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Signing secret for verifying Stripe webhook events (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# FIREBASE_SERVICE_ACCOUNT: Full service account JSON as a single string for Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT=""

# STRIPE_PUBLISHABLE_KEY: Public key for client-side Stripe card elements / Google Pay tokenization.
STRIPE_PUBLISHABLE_KEY=""

# Optional Direct Live Payment Links (Immediately debits user account without API keys):
STRIPE_PAYMENT_LINK=""
PAYPAL_ME_HANDLE="AndrewMelendez"
CASH_APP_CASHTAG="melendezandrew065"
VENMO_HANDLE="Andrew-Melendez"


